# Docker Compose defaults for local development.
POSTGRES_DB=wines
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

API_PORT=8000
RECOGNIZE_PORT=4001
ANNOTATION_CONTROLLER_PORT=9000
LLM_CONTROLLER_PORT=9100
WEB_PORT=3000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Server-only Next.js BFF URL inside the Compose network.
API_INTERNAL_URL=http://api:8000
WEB_ORIGIN=http://127.0.0.1:3000

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Local fallback uses ADMIN_PASSWORD_HASH. Set distinct hashes outside local development.
ANNOTATOR_USERNAME=annotator
ANNOTATOR_PASSWORD_HASH=
ML_SERVICE_USERNAME=ml-service
ML_SERVICE_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
INTERNAL_API_KEY=

# Set these to `id -u` and `id -g` if the Linux host user is not 1000:1000.
HOST_UID=1000
HOST_GID=1000

WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
CV_DEBUG_ARTIFACTS=false
CV_OCR_ENABLED=false
LOCAL_ML_CONTROLLER_URL=http://annotation-controller:9000/annotation/plan
LOCAL_ML_CONTROLLER_TOKEN=
LOCAL_ML_CONTROLLER_TIMEOUT_MS=60000
LOCAL_ML_CONTROLLER_MAX_RESPONSE_BYTES=2097152
LLM_WIZARD_CONTROLLER_URL=http://llm-controller:9100/annotation/plan
LLM_WIZARD_CONTROLLER_TOKEN=
LLM_WIZARD_CONTROLLER_TIMEOUT_MS=120000
LLM_WIZARD_CONTROLLER_MAX_RESPONSE_BYTES=2097152
# OpenAI Platform API credentials. API billing is separate from a ChatGPT subscription.
LLM_CONTROLLER_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=12000
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=2
# Qwen Model Studio credentials. Set LLM_CONTROLLER_BACKEND=qwen to use these.
QWEN_API_KEY=
# DASHSCOPE_API_KEY is accepted as a compatibility fallback for QWEN_API_KEY.
DASHSCOPE_API_KEY=
# Use the OpenAI-compatible base URL shown for your Model Studio workspace/region.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
QWEN_MAX_OUTPUT_TOKENS=4000
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_RETRIES=2
# chat keeps the existing stateless compatible endpoint. responses enables
# card-scoped provider Conversations and requires a workspace-specific base URL.
QWEN_STAGE_TRANSPORT=chat
DEV_ACTIVITY_LOG_ENABLED=true

# Optional SigLIP2 semantic evidence for existing Label candidates. The service
# is isolated behind the `siglip` Compose profile and Label remains functional
# when it is disabled or unavailable.
VISION_SERVICE_PORT=9200
SIGLIP_ENABLED=false
SIGLIP_LABEL_RERANK=true
SIGLIP_REGION_PROPOSALS=false
SIGLIP_MODE=off
SIGLIP_SERVICE_URL=http://vision-service:9200
SIGLIP_SERVICE_TOKEN=
SIGLIP_MODEL=google/siglip2-base-patch16-256
SIGLIP_MODEL_REVISION=950d2cab84b57b9d6cf03f95596bfa8fed3204d3
SIGLIP_TIMEOUT_MS=30000
SIGLIP_PRELOAD=true
DINO_ENABLED=false
DINO_MODEL=IDEA-Research/grounding-dino-tiny
DINO_MODEL_REVISION=a2bb814dd30d776dcf7e30523b00659f4f141c71
DINO_PROMPT=main wine label
DINO_THRESHOLD=0.18
DINO_TEXT_THRESHOLD=0.15
DINO_TIMEOUT_MS=30000
DINO_PRELOAD=false

# Frozen V5 runtime release; provision with vision-service/scripts/install_gallery.py.
V5_GALLERY_DIR=./.runtime/v5-rc1
V5_TIMEOUT_MS=120000
# Optional existing model caches; omitted values use Docker named volumes.
# V5_HF_CACHE=/absolute/path/to/huggingface
# V5_PADDLE_CACHE=/absolute/path/to/paddlex
# Provision once with vision-service/scripts/provision_dinov3.py.
# HF_TOKEN is read only by provisioning and is never forwarded to vision-service.
V5_DINOV3_MODEL_DIR=./.runtime/models/dinov3-vitb16-5931719e67bbdb9737e363e781fb0c67687896bc

# Frozen Core used by the scanner BFF; this demo timeout does not change HARD10.
# Docker web connects to the unchanged host C4 launcher through Docker Desktop.
VINEDETECT_CORE_URL=http://host.docker.internal:8765
VINEDETECT_CORE_TIMEOUT_MS=60000
CORE_IMAGE=vinedetect-core:c4
CORE_RUNTIME_DIR=./artifacts/core-runtime
CORE_PORT=8765
