# Local PostgreSQL container
POSTGRES_DB=wines
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application connection from the host
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wines

# Wine catalog source
BASE_URL=https://vino-svoe.ru
PER_PAGE=16
REQUEST_DELAY_MIN=0.8
REQUEST_DELAY_MAX=2.5
HTTP_TIMEOUT=20
USER_AGENT=Mozilla/5.0 (compatible; WineResearchBot/1.0; +local-development)

# HTTP API
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ANNOTATOR_USERNAME=annotator
ANNOTATOR_PASSWORD_HASH=
ML_SERVICE_USERNAME=ml-service
ML_SERVICE_PASSWORD_HASH=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8000
STATIC_ASSETS_ROOT=storage/images
STATIC_ASSETS_URL_PREFIX=/static/images
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
